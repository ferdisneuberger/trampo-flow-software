{
  "name": "trampo-flow-mcp",
  "version": "3.3.0",
  "description": "MCP server (stdio and Streamable HTTP) that lets AI agents read and update Trampo Flow job applications through the API.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "trampo-flow-mcp": "dist/index.js",
    "trampo-flow-mcp-http": "dist/http-main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "start:http": "node dist/http-main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
