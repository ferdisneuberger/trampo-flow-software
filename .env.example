# PostgreSQL
POSTGRES_USER=trampo
POSTGRES_PASSWORD=trampo_dev
POSTGRES_DB=trampo_flow
POSTGRES_PORT=5432

# Adminer
ADMINER_PORT=8080

# Edge público (Nginx)
WEB_PORT=5173

# API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.example.com

# Autenticação
# Usadas apenas para criar o primeiro usuário quando a tabela "users" está vazia.
# Depois do primeiro boot, podem ser removidas: o login lê do PostgreSQL.
# A senha precisa ter pelo menos 12 caracteres.
AUTH_USERNAME=admin
# Gere com: openssl rand -hex 12
AUTH_PASSWORD=
# Obrigatório. Gere com: openssl rand -hex 32 (mínimo de 32 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Sessão: validade do refresh token e tolerância para múltiplas abas
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_GRACE_SECONDS=10
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
