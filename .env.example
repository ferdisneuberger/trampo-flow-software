# PostgreSQL
POSTGRES_USER=trampo
POSTGRES_PASSWORD=trampo_dev
POSTGRES_DB=trampo_flow
POSTGRES_PORT=5432

# Adminer
ADMINER_PORT=8080

# Edge público (Nginx)
WEB_PORT=5173

# API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.example.com

# Autenticação
# Usadas apenas para criar o primeiro usuário quando a tabela "users" está vazia.
# Depois do primeiro boot, podem ser removidas: o login lê do PostgreSQL.
# O e-mail precisa ser válido e a senha precisa ter pelo menos 12 caracteres.
AUTH_EMAIL=admin@example.com
# Gere com: openssl rand -hex 12
AUTH_PASSWORD=
# Obrigatório. Gere com: openssl rand -hex 32 (mínimo de 32 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=5m
# Sessão: validade do refresh token e tolerância para múltiplas abas
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_GRACE_SECONDS=10
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# Cadastro e e-mail
APP_BASE_URL=http://localhost:5173
REGISTRATION_ENABLED=false
EMAIL_VERIFICATION_TTL_HOURS=24
VERIFICATION_RESEND_SECONDS=120
TERMS_VERSION=2026-11
# Obrigatório. Gere com: openssl rand -hex 32 (mínimo de 32 caracteres)
AUTH_TOKEN_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Trampo Flow
MAILPIT_PORT=8025

# Storage de arquivos (MinIO/S3)
S3_ACCESS_KEY=trampo
S3_SECRET_KEY=trampo_dev_secret
S3_BUCKET=trampo-files
S3_REGION=us-east-1
PASSWORD_RESET_TTL_MINUTES=60
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
API_KEY_DELETE=
