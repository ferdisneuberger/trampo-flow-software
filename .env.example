# PostgreSQL
POSTGRES_USER=trampo
POSTGRES_PASSWORD=trampo_dev
POSTGRES_DB=trampo_flow
POSTGRES_PORT=5432

# Edge público (Nginx)
WEB_PORT=5173

# API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.example.com

# Autenticação
# Crie usuários pelo cadastro público (REGISTRATION_ENABLED=true) ou direto no banco.
# Obrigatório. Gere com: openssl rand -hex 32 (mínimo de 32 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=5m
# Sessão: validade do refresh token e tolerância para múltiplas abas
REFRESH_TOKEN_TTL_HOURS=12
REFRESH_TOKEN_GRACE_SECONDS=10
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=120

# Cadastro e e-mail
APP_BASE_URL=http://localhost:5173
REGISTRATION_ENABLED=false
EMAIL_VERIFICATION_TTL_HOURS=12
VERIFICATION_RESEND_SECONDS=120
TERMS_VERSION=2026-11
# Obrigatório. Gere com: openssl rand -hex 32 (mínimo de 32 caracteres)
AUTH_TOKEN_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Trampo Flow
MAILPIT_PORT=8025

PASSWORD_RESET_TTL_MINUTES=15
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
API_KEY_DELETE=

# OAuth 2.1 para o MCP (entrega escura: desligado por padrão).
# Ordem de deploy: migration -> api -> mcp -> recriar o ingress -> OAUTH_ENABLED=true.
OAUTH_ENABLED=false
# Sem barra final. Padrão: APP_BASE_URL.
OAUTH_ISSUER=
# URL pública do MCP (a audiência dos tokens). Padrão: <issuer>/mcp.
MCP_PUBLIC_URL=
# Callbacks extras permitidos, separados por vírgula (além de Claude e loopback).
OAUTH_EXTRA_REDIRECT_URIS=
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
OAUTH_CODE_TTL_SECONDS=60
OAUTH_MAX_CLIENTS=1000
