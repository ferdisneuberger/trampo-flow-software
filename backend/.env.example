NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://trampo:trampo_dev@localhost:5432/trampo_flow
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.example.com

# Autenticação (obrigatório)
# Gere com: openssl rand -hex 32 (mínimo de 32 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=5m
REFRESH_TOKEN_TTL_HOURS=12
REFRESH_TOKEN_GRACE_SECONDS=10
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=120

APP_BASE_URL=http://localhost:5173
REGISTRATION_ENABLED=false
EMAIL_VERIFICATION_TTL_HOURS=12
VERIFICATION_RESEND_SECONDS=120
TERMS_VERSION=2026-11
AUTH_TOKEN_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Trampo Flow
PASSWORD_RESET_TTL_MINUTES=15
GOOGLE_CLIENT_ID=
