NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://trampo:trampo_dev@localhost:5432/trampo_flow
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.example.com

# Autenticação (obrigatório)
AUTH_EMAIL=admin@example.com
# Gere com: openssl rand -hex 12
AUTH_PASSWORD=
# Gere com: openssl rand -hex 32 (mínimo de 32 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=8h
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

APP_BASE_URL=http://localhost:5173
REGISTRATION_ENABLED=false
EMAIL_VERIFICATION_TTL_HOURS=24
VERIFICATION_RESEND_SECONDS=120
TERMS_VERSION=2026-11
AUTH_TOKEN_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Trampo Flow
PASSWORD_RESET_TTL_MINUTES=60
