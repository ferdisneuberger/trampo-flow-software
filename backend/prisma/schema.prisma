generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model Application {
  id           String            @id @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String            @db.VarChar(120)
  link         String            @db.VarChar(2048)
  company      String            @db.VarChar(120)
  companyUrl   String?           @map("company_url") @db.VarChar(2048)
  position     Int               @default(0)
  status       ApplicationStatus @default(PENDING)
  currentPhase String            @map("current_phase") @db.VarChar(120)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, deletedAt])
  @@map("applications")
}

model User {
  id                   String                @id @db.Uuid
  email                String?               @unique @db.VarChar(254)
  firstName            String?               @map("first_name") @db.VarChar(30)
  lastName             String?               @map("last_name") @db.VarChar(30)
  emailVerifiedAt      DateTime?             @map("email_verified_at")
  verificationSentAt   DateTime?             @map("verification_sent_at")
  termsAcceptedAt      DateTime?             @map("terms_accepted_at")
  termsVersion         String?               @map("terms_version") @db.VarChar(20)
  username             String?               @unique @db.VarChar(120)
  googleId             String?               @unique @map("google_id") @db.VarChar(255)
  passwordHash         String?               @map("password_hash") @db.VarChar(255)
  themePreference      String                @default("light") @map("theme_preference") @db.VarChar(10)
  lastLoginAt          DateTime?             @map("last_login_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  applications         Application[]
  refreshTokens        RefreshToken[]
  authTokens           AuthToken[]
  personalAccessTokens PersonalAccessToken[]
  oauthGrants          OAuthGrant[]

  @@map("users")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model RefreshToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PersonalAccessToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String    @db.VarChar(60)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  prefix     String    @db.VarChar(12)
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  scope      String    @default("applications:read applications:write") @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("personal_access_tokens")
}

model OAuthClient {
  id           String       @id @db.Uuid
  clientId     String       @unique @map("client_id") @db.VarChar(2048)
  name         String       @db.VarChar(120)
  redirectUris String[]     @map("redirect_uris")
  source       String       @db.VarChar(10)
  createdAt    DateTime     @default(now()) @map("created_at")
  lastUsedAt   DateTime?    @map("last_used_at")
  grants       OAuthGrant[]

  @@index([source, createdAt])
  @@map("oauth_clients")
}

// Um grant é a autorização de uma pessoa a um aplicativo. O índice único
// parcial (user_id, client_id) WHERE revoked_at IS NULL é criado em SQL na
// migration, porque o Prisma não o declara.
model OAuthGrant {
  id            String               @id @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientRef     String               @map("client_id") @db.Uuid
  client        OAuthClient          @relation(fields: [clientRef], references: [id], onDelete: Restrict)
  scope         String               @db.VarChar(200)
  resource      String               @db.VarChar(2048)
  createdAt     DateTime             @default(now()) @map("created_at")
  lastUsedAt    DateTime?            @map("last_used_at")
  revokedAt     DateTime?            @map("revoked_at")
  codes         OAuthCode[]
  accessTokens  OAuthAccessToken[]
  refreshTokens OAuthRefreshToken[]

  @@index([userId])
  @@index([clientRef])
  @@map("oauth_grants")
}

model OAuthCode {
  id            String     @id @db.Uuid
  codeHash      String     @unique @map("code_hash") @db.VarChar(64)
  grantId       String     @map("grant_id") @db.Uuid
  grant         OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  redirectUri   String     @map("redirect_uri") @db.VarChar(2048)
  codeChallenge String     @map("code_challenge") @db.VarChar(128)
  expiresAt     DateTime   @map("expires_at")
  usedAt        DateTime?  @map("used_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([grantId])
  @@index([expiresAt])
  @@map("oauth_codes")
}

model OAuthAccessToken {
  id        String     @id @db.Uuid
  tokenHash String     @unique @map("token_hash") @db.VarChar(64)
  grantId   String     @map("grant_id") @db.Uuid
  grant     OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  scope     String     @db.VarChar(200)
  expiresAt DateTime   @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([grantId])
  @@index([expiresAt])
  @@map("oauth_access_tokens")
}

model OAuthRefreshToken {
  id         String     @id @db.Uuid
  tokenHash  String     @unique @map("token_hash") @db.VarChar(64)
  grantId    String     @map("grant_id") @db.Uuid
  grant      OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  familyId   String     @map("family_id") @db.Uuid
  replacedBy String?    @map("replaced_by") @db.Uuid
  revokedAt  DateTime?  @map("revoked_at")
  expiresAt  DateTime   @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([grantId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("oauth_refresh_tokens")
}
