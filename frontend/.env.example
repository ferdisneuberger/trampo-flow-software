# URL usada pelo cliente HTTP. Use /api para aproveitar o proxy do Vite local ou o ingress no Compose.
VITE_API_URL=/api

# Nome exibido na interface.
VITE_APP_NAME=Trampo Flow

# Limites de upload exibidos e validados no cliente (mantenha alinhados ao backend).
VITE_MAX_FILE_SIZE_MB=5
VITE_MAX_FILES_PER_APPLICATION=3

# Destino do proxy /api configurado no vite.config.ts para o desenvolvimento local.
VITE_API_PROXY_TARGET=http://localhost:3000
