{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "trampo-flow",
      "folder": "Trampo Flow",
      "interval": "1m",
      "rules": [
        {
          "uid": "trampo-api-down",
          "title": "Trampo Flow: API fora do ar",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "PROMETHEUS_DS_UID",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PROMETHEUS_DS_UID"
                },
                "expr": "min(up{job=\"trampo-flow-api\"})",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C"
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "2m",
          "annotations": {
            "summary": "A API do Trampo Flow não está sendo raspada pelo Prometheus.",
            "description": "O alvo `trampo-flow-api` está fora ou sem resposta há mais de 2 minutos. Confira `docker compose ps`, o log da API e o Traefik."
          },
          "labels": {
            "app": "trampo-flow",
            "severity": "critical"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "trampo-flow-email"
          }
        },
        {
          "uid": "trampo-mcp-down",
          "title": "Trampo Flow: MCP fora do ar",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "PROMETHEUS_DS_UID",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PROMETHEUS_DS_UID"
                },
                "expr": "min(up{job=\"trampo-flow-mcp\"})",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C"
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "2m",
          "annotations": {
            "summary": "O serviço MCP do Trampo Flow não está sendo raspado.",
            "description": "O alvo `trampo-flow-mcp` está fora há mais de 2 minutos: o conector do Claude e os agentes ficam sem acesso."
          },
          "labels": {
            "app": "trampo-flow",
            "severity": "high"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "trampo-flow-email"
          }
        },
        {
          "uid": "trampo-db-down",
          "title": "Trampo Flow: banco de dados fora",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "PROMETHEUS_DS_UID",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PROMETHEUS_DS_UID"
                },
                "expr": "min(trampo_db_up{job=\"trampo-flow-api\"})",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "1m",
          "annotations": {
            "summary": "A API não consegue consultar o banco.",
            "description": "A sonda `SELECT 1` da API falha há mais de 1 minuto. O `/health` responde 503 e nada funciona sem o Postgres."
          },
          "labels": {
            "app": "trampo-flow",
            "severity": "critical"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "trampo-flow-email"
          }
        },
        {
          "uid": "trampo-5xx-ratio",
          "title": "Trampo Flow: erros 5xx acima de 2%",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "PROMETHEUS_DS_UID",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PROMETHEUS_DS_UID"
                },
                "expr": "(sum(increase(trampo_http_requests_total{job=\"trampo-flow-api\",status=~\"5..\"}[5m])) / clamp_min(sum(increase(trampo_http_requests_total{job=\"trampo-flow-api\"}[5m])), 1)) and on() (sum(increase(trampo_http_requests_total{job=\"trampo-flow-api\",status=~\"5..\"}[5m])) >= 3)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.02
                      ]
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Mais de 2% das respostas da API são 5xx.",
            "description": "Pelo menos 3 erros 5xx e mais de 2% das respostas nos últimos 5 minutos. Veja o painel \"Requisições HTTP\" e o log da API."
          },
          "labels": {
            "app": "trampo-flow",
            "severity": "high"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "trampo-flow-email"
          }
        },
        {
          "uid": "trampo-latency-p95",
          "title": "Trampo Flow: latência alta (p95 acima de 1 s)",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "PROMETHEUS_DS_UID",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PROMETHEUS_DS_UID"
                },
                "expr": "max(histogram_quantile(0.95, sum by (le, route) (rate(trampo_http_request_duration_seconds_bucket{job=\"trampo-flow-api\"}[10m]))) and on (route) (sum by (route) (increase(trampo_http_request_duration_seconds_count{job=\"trampo-flow-api\"}[10m])) >= 10))",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        1
                      ]
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "annotations": {
            "summary": "O p95 de alguma rota passou de 1 segundo.",
            "description": "Uma rota com pelo menos 10 requisições em 10 minutos tem p95 acima de 1 s. Veja a latência por rota e as consultas ao banco."
          },
          "labels": {
            "app": "trampo-flow",
            "severity": "medium"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "trampo-flow-email"
          }
        },
        {
          "uid": "trampo-session-reuse",
          "title": "Trampo Flow: sessão reutilizada (possível roubo)",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "PROMETHEUS_DS_UID",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PROMETHEUS_DS_UID"
                },
                "expr": "sum(increase(trampo_auth_session_refreshes_total{job=\"trampo-flow-api\",result=\"reused\"}[10m]))",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Um refresh token de sessão foi reutilizado.",
            "description": "Reutilizar um refresh token já rotacionado, fora da janela de graça, indica que a credencial pode ter sido roubada. A família de sessões é revogada; avise o usuário."
          },
          "labels": {
            "app": "trampo-flow",
            "severity": "high"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "trampo-flow-email"
          }
        },
        {
          "uid": "trampo-oauth-reuse",
          "title": "Trampo Flow: código ou refresh OAuth reutilizado",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "PROMETHEUS_DS_UID",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PROMETHEUS_DS_UID"
                },
                "expr": "sum(increase(trampo_oauth_code_reuse_total{job=\"trampo-flow-api\"}[10m])) + sum(increase(trampo_oauth_refresh_reuse_total{job=\"trampo-flow-api\"}[10m]))",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Um código de autorização ou refresh token OAuth foi reutilizado.",
            "description": "Sinal de roubo de credencial no fluxo OAuth: o grant é revogado (código) ou a família de refresh (refresh). Confira \"Aplicativos conectados\" do usuário."
          },
          "labels": {
            "app": "trampo-flow",
            "severity": "high"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "trampo-flow-email"
          }
        },
        {
          "uid": "trampo-bruteforce",
          "title": "Trampo Flow: possível força bruta no login",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "PROMETHEUS_DS_UID",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PROMETHEUS_DS_UID"
                },
                "expr": "sum(increase(trampo_auth_login_attempts_total{job=\"trampo-flow-api\",result=\"invalid_credentials\"}[5m]))",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        30
                      ]
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Mais de 30 logins com senha errada em 5 minutos.",
            "description": "Volume anormal de credenciais inválidas. Confira se o limitador de login travou e se há um IP concentrando as tentativas no Traefik/Cloudflare."
          },
          "labels": {
            "app": "trampo-flow",
            "severity": "medium"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "trampo-flow-email"
          }
        },
        {
          "uid": "trampo-login-lockout",
          "title": "Trampo Flow: login travado pelo limitador",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "PROMETHEUS_DS_UID",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PROMETHEUS_DS_UID"
                },
                "expr": "sum(increase(trampo_auth_login_lockouts_total{job=\"trampo-flow-api\"}[10m]))",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "O limitador global de login travou.",
            "description": "O limitador de login tem um estado global: enquanto travado, **ninguém** consegue entrar. Pode ser um ataque ou um usuário errando a senha."
          },
          "labels": {
            "app": "trampo-flow",
            "severity": "medium"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "trampo-flow-email"
          }
        },
        {
          "uid": "trampo-registrations-spike",
          "title": "Trampo Flow: pico de cadastros",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "PROMETHEUS_DS_UID",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PROMETHEUS_DS_UID"
                },
                "expr": "sum(increase(trampo_auth_registrations_total{job=\"trampo-flow-api\",result=\"created\"}[1h]))",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        20
                      ]
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Mais de 20 cadastros em 1 hora.",
            "description": "Volume anormal de contas novas: pode ser divulgação ou abuso. Confira `REGISTRATION_ENABLED` e o log de cadastros."
          },
          "labels": {
            "app": "trampo-flow",
            "severity": "medium"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "trampo-flow-email"
          }
        },
        {
          "uid": "trampo-mail-failing",
          "title": "Trampo Flow: falha no envio de e-mail",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "PROMETHEUS_DS_UID",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PROMETHEUS_DS_UID"
                },
                "expr": "sum(increase(trampo_mail_sent_total{job=\"trampo-flow-api\",result=\"error\"}[15m]))",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
